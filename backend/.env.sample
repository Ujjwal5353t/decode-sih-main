# ─────────────────────────────────────────────
# Decode-SIH Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── PostgreSQL (Render / Supabase / Railway) ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── JWT Auth ──────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary (file/PDF storage) ─────────────
# https://console.cloudinary.com → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Admin seed ────────────────────────────────
# These are seeded into the DB on first startup
ADMIN_EMAIL=admin003@gmail.com
ADMIN_PASSWORD=123456789

# ── App Settings ──────────────────────────────
APP_NAME=Decode-SIH API
APP_VERSION=0.1.0
DEBUG=false

# ── LLM (diagnostic quiz question generation) ──
# https://aistudio.google.com/apikey — only needed to run
# scripts/generate_questions.py, not for the main app server.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
